<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_graph"
    app:startDestination="@id/qrScannerFragment">

    <fragment
        android:id="@+id/qrScannerFragment"
        android:name="com.epicjugador.qrscanneraagapp.ui.QrScanner.QrScannerFragment"
        android:label="fragment_qr_scanner"
        tools:layout="@layout/fragment_qr_scanner">
        <action
            android:id="@+id/action_qrScannerFragment_to_infoFragment"
            app:destination="@id/infoFragment" />
    </fragment>

    <fragment
        android:id="@+id/infoFragment"
        android:name="com.epicjugador.qrscanneraagapp.ui.Info.InfoFragment">

        <argument
            android:name="result"
            app:argType="string" />
    </fragment>

</navigation>